generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  address              String?
  phone                String?
  status               CompanyStatus         @default(TRIAL)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  planId               String?
  deletedAt            DateTime?
  cancelAtPeriodEnd    Boolean               @default(false)
  stripeCustomerId     String?               @unique
  stripeSubscriptionId String?               @unique
  subscriptionEndsAt   DateTime?
  trialEndsAt          DateTime?
  scheduledPlanId      String?
  subscriptionState    SubscriptionState     @default(ACTIVE)
  billingEvents        BillingEvent[]
  branches             Branch[]
  categories           Category[]
  plan                 SubscriptionPlan?     @relation(fields: [planId], references: [id])
  enabledModules       CompanyModule[]
  usage                CompanyUsage?
  customers            Customer[]
  invoices             Invoice[]
  products             Product[]
  sales                Sale[]
  subscriptionPayments SubscriptionPayment[]
  users                User[]
}

model SubscriptionPlan {
  id                   String             @id @default(cuid())
  name                 String             @unique
  description          String?
  duration             Int
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  allowCourtesy        Boolean            @default(false)
  code                 String?            @unique
  isTrialEligible      Boolean            @default(true)
  maxBranches          Int                @default(-1)
  maxProducts          Int                @default(-1)
  maxUsers             Int                @default(-1)
  monthlyPrice         Decimal            @db.Decimal(12, 2)
  status               PlanStatus         @default(ACTIVE)
  version              Int                @default(1)
  yearlyPrice          Decimal            @db.Decimal(12, 2)
  maxDataRetentionDays Int                @default(365)
  maxEmailsPerMonth    Int                @default(500)
  maxStorageMb         Int                @default(1024)
  maxVentasMensuales   Int                @default(-1)
  companies            Company[]
  priceHistory         PlanPriceHistory[]
  modules              SystemModule[]     @relation("SubscriptionPlanToSystemModule")
}

model CompanyUsage {
  id                String   @id @default(cuid())
  companyId         String   @unique
  emailsSent        Int      @default(0)
  salesCount        Int      @default(0)
  storageUsedMb     Int      @default(0)
  currentCycleStart DateTime @default(now())
  currentCycleEnd   DateTime
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id])
}

model PlanPriceHistory {
  id            String           @id @default(cuid())
  planId        String
  monthlyPrice  Decimal          @db.Decimal(12, 2)
  yearlyPrice   Decimal          @db.Decimal(12, 2)
  effectiveDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
}

model SystemModule {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  status      ModuleStatus       @default(IN_DEVELOPMENT)
  companies   CompanyModule[]
  plans       SubscriptionPlan[] @relation("SubscriptionPlanToSystemModule")
}

model CompanyModule {
  id        String       @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id])
  module    SystemModule @relation(fields: [moduleId], references: [id])

  @@unique([companyId, moduleId])
}

model Role {
  id          String       @id @default(cuid())
  name        String
  description String?
  companyId   String?
  createdAt   DateTime     @default(now())
  users       User[]
  permissions Permission[] @relation("PermissionToRole")

  @@unique([name, companyId])
}

model Permission {
  id        String   @id @default(cuid())
  action    String
  resource  String
  createdAt DateTime @default(now())
  roles     Role[]   @relation("PermissionToRole")

  @@unique([action, resource])
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String
  name            String?
  systemRole      SystemRole @default(COMPANY_USER)
  roleId          String?
  companyId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  themePreference String     @default("dark")
  image           String?
  documentType    String?
  documentNumber  String?
  phone           String?
  address         String?
  company         Company?   @relation(fields: [companyId], references: [id])
  role            Role?      @relation(fields: [roleId], references: [id])
}

model Branch {
  id        String      @id @default(cuid())
  name      String
  address   String?
  phone     String?
  companyId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  company   Company     @relation(fields: [companyId], references: [id])
  inventory Inventory[]
  sales     Sale[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([name, companyId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  barcode     String?
  salePrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal?    @db.Decimal(12, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  categoryId  String
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventory   Inventory[]
  category    Category    @relation(fields: [categoryId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  saleItems   SaleItem[]

  @@unique([barcode, companyId])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  minStock  Decimal  @default(0) @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  sales     Sale[]
}

model Sale {
  id            String     @id @default(cuid())
  saleNumber    Int        @default(autoincrement())
  total         Decimal    @db.Decimal(12, 2)
  taxAmount     Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod String
  status        String     @default("COMPLETED")
  branchId      String
  companyId     String
  customerId    String?
  createdAt     DateTime   @default(now())
  branch        Branch     @relation(fields: [branchId], references: [id])
  company       Company    @relation(fields: [companyId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  product    Product @relation(fields: [productId], references: [id])
  sale       Sale    @relation(fields: [saleId], references: [id])
}

model SubscriptionPayment {
  id              String   @id @default(cuid())
  companyId       String
  stripeInvoiceId String?  @unique
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  status          String
  billingReason   String?
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String        @id @default(cuid())
  companyId          String
  subscriptionId     String?
  planId             String
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("USD")
  status             InvoiceStatus @default(PENDING)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  paidDate           DateTime?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id])
  payments           Payment[]
}

model Payment {
  id                   String        @id @default(cuid())
  invoiceId            String
  companyId            String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        String
  transactionReference String?
  status               PaymentStatus @default(SUCCESS)
  createdAt            DateTime      @default(now())
  invoice              Invoice       @relation(fields: [invoiceId], references: [id])
}

model BillingEvent {
  id          String           @id @default(cuid())
  companyId   String
  eventType   BillingEventType
  description String?
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id])
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SystemRole {
  SAAS_SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum SubscriptionState {
  ACTIVE
  PENDING_DOWNGRADE
  OVER_LIMIT
  GRACE_PERIOD
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum BillingEventType {
  UPGRADE
  DOWNGRADE
  SUSPENSION
  REACTIVATION
  RENEWAL
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
  BETA
  IN_DEVELOPMENT
}
