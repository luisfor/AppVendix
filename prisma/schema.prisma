generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SystemRole {
  SAAS_SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum SubscriptionState {
  ACTIVE
  PENDING_DOWNGRADE
  OVER_LIMIT
  GRACE_PERIOD
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum BillingEventType {
  UPGRADE
  DOWNGRADE
  SUSPENSION
  REACTIVATION
  RENEWAL
}

model Company {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  address         String?
  phone           String?
  status          CompanyStatus  @default(TRIAL)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Subscription Relation
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  
  // Feature Modules
  enabledModules  CompanyModule[]

  branches        Branch[]
  users           User[]
  products        Product[]
  categories      Category[]
  customers       Customer[]
  sales           Sale[]

  // Billing & Stripe Integration
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionEndsAt   DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  
  subscriptionPayments SubscriptionPayment[]
  usage           CompanyUsage?

  // Upgrade & Downgrade State
  subscriptionState SubscriptionState @default(ACTIVE)
  scheduledPlanId   String?

  invoices        Invoice[]
  billingEvents   BillingEvent[]

  deletedAt       DateTime?
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String?  @unique // Identifies versions of the same plan
  name            String   @unique
  description     String?
  monthlyPrice    Decimal  @db.Decimal(12, 2)
  yearlyPrice     Decimal  @db.Decimal(12, 2)
  duration        Int      // in days (legacy, keeping for compatibility if needed or semantics)
  status          PlanStatus @default(ACTIVE)
  
  // Limits (-1 means unlimited)
  maxUsers             Int      @default(-1)
  maxBranches          Int      @default(-1)
  maxProducts          Int      @default(-1)
  maxEmailsPerMonth    Int      @default(500)
  maxVentasMensuales   Int      @default(-1)
  maxDataRetentionDays Int      @default(365)
  maxStorageMb         Int      @default(1024)
  
  // Features
  isTrialEligible Boolean  @default(true)
  allowCourtesy   Boolean  @default(false)
  
  // Versioning
  version         Int      @default(1)

  companies       Company[]
  modules         SystemModule[]
  priceHistory    PlanPriceHistory[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompanyUsage {
  id                String   @id @default(cuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id])
  emailsSent        Int      @default(0)
  salesCount        Int      @default(0)
  storageUsedMb     Int      @default(0)
  currentCycleStart DateTime @default(now())
  currentCycleEnd   DateTime 
  
  updatedAt         DateTime @updatedAt
}

model PlanPriceHistory {
  id             String   @id @default(cuid())
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  monthlyPrice   Decimal  @db.Decimal(12, 2)
  yearlyPrice    Decimal  @db.Decimal(12, 2)
  effectiveDate  DateTime @default(now())
  
  createdAt      DateTime @default(now())
}

model SystemModule {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., 'INVENTORY', 'REPORTS_PRO', 'WORKSHOP'
  name        String
  description String?
  plans       SubscriptionPlan[]
  companies   CompanyModule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyModule {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  moduleId  String
  module    SystemModule @relation(fields: [moduleId], references: [id])
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([companyId, moduleId])
}

model Role {
  id          String       @id @default(cuid())
  name        String
  description String?
  companyId   String?      // Null for global roles (Super Admin)
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())

  @@unique([name, companyId])
}

model Permission {
  id          String   @id @default(cuid())
  action      String   // e.g., 'READ_SALES', 'MANAGE_COMPANIES'
  resource    String   // e.g., 'SALES', 'SAAS_PANEL'
  roles       Role[]
  createdAt   DateTime @default(now())

  @@unique([action, resource])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String?
  systemRole  SystemRole @default(COMPANY_USER)
  
  // RBAC
  roleId      String?
  role        Role?      @relation(fields: [roleId], references: [id])
  
  companyId   String?    // Null for SaaS Super Admins
  company     Company?   @relation(fields: [companyId], references: [id])
  
  themePreference String @default("dark")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inventory   Inventory[]
  sales       Sale[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, companyId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  barcode     String?
  salePrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inventory   Inventory[]
  saleItems   SaleItem[]

  @@unique([barcode, companyId])
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(0) @db.Decimal(12, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, branchId])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  sales       Sale[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id            String   @id @default(cuid())
  saleNumber    Int      @default(autoincrement())
  total         Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod String
  status        String   @default("COMPLETED")
  branchId      String
  branch      Branch   @relation(fields: [branchId], references: [id])
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  createdAt     DateTime @default(now())
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
}

// -----------------------------------------------------------------------------
// Billing & Invoices
// -----------------------------------------------------------------------------

model SubscriptionPayment {
  id              String   @id @default(cuid())
  companyId       String
  stripeInvoiceId String?  @unique
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  status          String   // e.g., 'paid', 'open', 'void', 'uncollectible'
  billingReason   String?  // e.g., 'subscription_create', 'subscription_cycle'
  createdAt       DateTime @default(now())

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id])
  subscriptionId      String?       // Matches stripeSubscriptionId
  planId              String
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("USD")
  status              InvoiceStatus @default(PENDING)
  issueDate           DateTime      @default(now())
  dueDate             DateTime
  paidDate            DateTime?
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  
  payments            Payment[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Payment {
  id                   String        @id @default(cuid())
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id])
  companyId            String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        String        // e.g., 'STRIPE', 'MANUAL', 'BANK_TRANSFER'
  transactionReference String?       // Stripe Charge ID or Manual Ref
  status               PaymentStatus @default(SUCCESS)
  createdAt            DateTime      @default(now())
}

model BillingEvent {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  eventType   BillingEventType
  description String?
  createdAt   DateTime         @default(now())
}
